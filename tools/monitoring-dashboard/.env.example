# =============================================================================
# Intel XPU Monitoring Dashboard — environment configuration
# =============================================================================
# Copy this to `.env` and edit the REQUIRED fields below.
# Then run: docker compose -f compose.with-metrics-manager.yaml up -d --build

# --- Grafana ----------------------------------------------------------------
# Admin password for http://localhost:3000 (admin / admin)
# WARNING: This is a test default. For production, change to something strong.
GF_SECURITY_ADMIN_PASSWORD=admin
# Allow read-only viewing without login (handy for kiosk/NOC screens).
GF_AUTH_ANONYMOUS_ENABLED=false
# Host port for the Grafana UI.
HOST_GRAFANA_PORT=3000

# --- Prometheus retention (Xintian: cap on disk usage) ----------------------
# Drop samples older than this window.
PROM_RETENTION_TIME=7d
# SOFT cap on compacted blocks (WAL/head not counted). Keep disk >= 2x this.
PROM_RETENTION_SIZE=2GB
# Optional: publish Prometheus on the host for debugging (collides with the
# metrics-manager API on 9090, so a different port). Off by default — see compose.
# HOST_PROMETHEUS_PORT=9091

# --- metrics-manager (consumed by the included service) ---------------------
# Stable host label so dashboards keep a consistent `host=` across reboots.
METRICS_MANAGER_HOSTNAME=
# Image registry/tag if pulling instead of building locally.
# REGISTRY=
# TAG=2026.1.0

# --- Proxy (optional, repo-wide convention) ---------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
